rules_version = '2';
// Security rules for Ciao Board friend messages. Paste these into
// Firebase console → Firestore Database → Rules (see FRIENDS-SETUP.md).
//
// invites/{code}                     one-time pairing code made by a board, valid 24 hours
// links/{code}                       two boards that both agreed to connect (id = the invite code)
// links/{code}/messages/{id}         a message from one connected board to the other
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function shortText(v, max) { return v is string && v.size() > 0 && v.size() <= max; }

    match /invites/{code} {
      // Only someone who knows the code can look it up; invites can't be listed
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'name', 'expires'])
        && request.resource.data.from == request.auth.uid
        && shortText(request.resource.data.name, 40)
        && request.resource.data.expires is timestamp
        && request.resource.data.expires > request.time
        && request.resource.data.expires < request.time + duration.value(25, 'h');
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    match /links/{code} {
      function invite() { return get(/databases/$(database)/documents/invites/$(code)).data; }

      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // The person accepting creates the link, and only from a live invite made by the other board.
      // The link's id is the invite code, so each invite can be used once.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'names', 'created'])
        && request.resource.data.members.size() == 2
        && request.resource.data.members[1] == request.auth.uid
        && request.resource.data.members[0] != request.auth.uid
        && exists(/databases/$(database)/documents/invites/$(code))
        && invite().from == request.resource.data.members[0]
        && invite().expires > request.time
        && request.resource.data.names.keys().hasOnly(request.resource.data.members)
        && shortText(request.resource.data.names[request.resource.data.members[0]], 40)
        && shortText(request.resource.data.names[request.resource.data.members[1]], 40)
        && request.resource.data.created == request.time;
      // Either board can disconnect
      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{id} {
        function members() { return get(/databases/$(database)/documents/links/$(code)).data.members; }

        // Only the recipient can read a message, and delete it once it has been shown
        allow read, delete: if signedIn() && resource.data.to == request.auth.uid
          && request.auth.uid in members();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['from', 'to', 'text', 'sent'])
          && request.auth.uid in members()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to in members()
          && request.resource.data.to != request.auth.uid
          && shortText(request.resource.data.text, 300)
          && request.resource.data.sent == request.time;
      }
    }
  }
}
